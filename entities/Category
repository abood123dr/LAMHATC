{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "اسم القسم"
    },
    "description": {
      "type": "string",
      "description": "وصف قصير للقسم"
    },
    "image_url": {
      "type": "string",
      "description": "صورة غلاف القسم"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "ترتيب ظهور القسم في المنيو"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "إظهار القسم للعملاء"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
